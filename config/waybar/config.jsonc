[
    {
        // ===================================
        // MAIN BAR (Workstation Center & Laptop)
        // ===================================
        "layer": "top",
        "position": "top",
        "output": ["DP-5", "eDP-1"],
        "height": 30,
        "modules-left": ["hyprland/workspaces", "niri/workspaces"],
        "modules-center": ["clock"],
        "modules-right": ["network", "cpu", "memory", "pulseaudio", "backlight", "battery", "tray"],

        // Module Definitions
        "hyprland/workspaces": {
            // "format": "{name}",
            "format": "{icon} {windows}",
            "format-window-separator": " ",
            "disable-scroll": true,
            "on-click": "activate",
            "sort-by-number": true,
            "window-rewrite-default": " ",
            "window-rewrite": {
                "title<.*OpenCode.*>": "󱚣",
                "title<.*nvim.*>": "",
                "title<.*vim.*>": "",
                "title<.*yazi.*>": "",
                "class<Element>": "",
                "class<firefox>": " ",
                "class<brave-browser>": " ",
                "class<thunderbird>": "",
                "kitty": "",
                "class<signal>": "",
                "class<libreoffice-writer>": "",
                "class<libreoffice-calc>": "",
                "class<libreoffice-impress>": "",
                "class<libreoffice-draw>": "",
                "class<evince>": "",
                "class<Papers>": "",
                "class<zathura>": "",
                "class<writer>": "",
                "class<mpv>": ""
            }
        },
        "clock": {
            "interval": 60,
            "format": "  {:%H:%M}", 
            "max-length": 25,
            "tooltip-format": "  {:%A, %d %B %Y}" 
        },
        "cpu": {
            "interval": 1,
            "format": " {usage}%", 
            "tooltip": true
        },
        "memory": {
            "interval": 1,
            "format": " {percentage}%", 
            "format-alt": "  {used:0.1f}G", 
            "tooltip": true,
            "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB used"
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{capacity}% {icon}",
            "format-icons": ["", "", "", "", ""]
        },
        "network": {
            "format-wifi": "{essid} ({signalStrength}%) ",
            "format-ethernet": "{ipaddr}/{cidr} 󰈀",
            "tooltip-format": "{ifname} via {gwaddr}",
            "format-linked": "{ifname} (No IP) ",
            "format-disconnected": "Disconnected ⚠",
            "format-alt": "{ipaddr}/{cidr}" 
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-muted": "", 
            "format-icons": {
                "default": ["", "", ""] 
            },
            "on-click": "pamixer -t", 
            "on-scroll-up": "pamixer -i 5", 
            "on-scroll-down": "pamixer -d 5", 
            "tooltip": false
        },
        "backlight": {
            "device": "intel_backlight", 
            "format": "{icon} {percent}%",
            "format-icons": ["", "", "", "", "", "", "", "", ""], 
            "on-scroll-up": "brightnessctl set +5%",
            "on-scroll-down": "brightnessctl set 5%-",
            "tooltip": false
        },
        "niri/workspaces": {
            "format": "{icon}",
            "format-icons": {
                "active": "",
                "default": ""
            }
        }
    },
    {
        // ===================================
        // SIDE BARS (Workstation Left & Right)
        // ===================================
        "layer": "top",
        "position": "top",
        "output": ["DP-6", "HDMI-A-3"],
        "height": 30,
        "modules-left": ["hyprland/workspaces", "niri/workspaces#side"],

        "niri/workspaces#side": {
            "format": "{icon}",
            "format-icons": {
                "active": "",
                "default": ""
            }
        }

    }
]
