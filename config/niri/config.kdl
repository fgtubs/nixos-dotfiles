// config.kdl

// Autostart your ecosystem tools
spawn-at-startup "xwayland-satellite"
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "swaybg" "-m" "fill" "-i" "/home/fin/nixos-dotfiles/wallpapers/wallpaper_surf.jpg"

// Apps that should open at startup
// spawn-at-startup "kitty"
// spawn-at-startup "firefox"
spawn-at-startup "sh" "-c" "if [ \"$(cat /etc/hostname)\" = \"workstation\" ]; then thunderbird; fi"

prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
    }
}

// ===============================
// Monitor Configuration
// ===============================

// Left Monitor (Dell U2424H)
output "DP-6" {
    mode "1920x1080@120.000" 
    transform "270"
    position x=0 y=0
}

// Center Monitor (Dell U2424H)
output "DP-5" {
    mode "1920x1080@120.000"
    position x=1080 y=0
}

// Right Monitor (BenQ GW2470)
output "HDMI-A-3" {
    mode "1920x1080@60.000"
    position x=3000 y=0
}

// Your Laptop Screen (Ignored when not plugged in)
output "eDP-1" {
    scale 1.5 
    position x=0 y=0
}

layout {
    gaps 8

    focus-ring {
        width 2
        active-color "#33ccff"
        inactive-color "#595959"
    }
}

binds {
    // --- Spawn of Things ---
    Mod+Q { spawn "kitty"; }
    Mod+R { spawn "wofi" "--show" "drun"; }
    Mod+E { spawn "kitty" "--class" "yazi" "-e" "yazi"; }
    Mod+F { spawn "firefox"; }

    // --- Essential Window Management ---
    Mod+C { close-window; }
    Mod+M { quit; } // Logs you out of Niri
    Mod+I { spawn "hyprlock"; } // Go to lock screen
    Mod+V { maximize-column; }
    Mod+SHIFT+V { fullscreen-window; }
    Mod+SHIFT+Slash { show-hotkey-overlay; }
    Print { screenshot; }

    // --- Basic Navigation ---
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-workspace-up; }
    Mod+J     { focus-workspace-down; }

    // --- Overview ---
    Mod+Z     { toggle-overview; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // --- Basic Workspaces ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }


    // ===============================
    // Multi-Monitor Controls
    // ===============================
    
    // Move focus (your cursor) between your 3 screens
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+L     { focus-monitor-right; }

    // Move the active window (column) to another screen
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }


    // ===============================
    // Volume & Brightness Keys
    // ===============================
    
    // The allow-when-locked=true parameter ensures you can still change 
    // volume and brightness even if your screen is locked by Hyprlock.
    
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }

    // Media Player Controls (Spotify, YouTube, etc.)
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }

}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id="kitty"
    match is-active=true
    opacity 1.0 
}

window-rule {
    match app-id="firefox"
    open-on-output "DP-6"
    open-maximized true 
}

window-rule {
    match app-id="thunderbird"
    open-on-output "HDMI-A-3"
    open-maximized true
}
