// config.kdl

// Autostart your ecosystem tools
spawn-at-startup "xwayland-satellite"
spawn-at-startup "waybar"
spawn-at-startup "swaync"
spawn-at-startup "swaybg" "-m" "fill" "-i" "/home/fin/nixos-dotfiles/wallpapers/wallpaper_autumn.jpg"

prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
    }
}

layout {
    gaps 8

    focus-ring {
        width 2
        active-color "#33ccff"
        inactive-color "#595959"
    }
}

binds {
    Mod+Q { spawn "kitty"; }
    Mod+R { spawn "wofi" "--show" "drun"; }
    Mod+E { spawn "kitty" "--class" "yazi" "-e" "yazi"; }

    // --- Essential Window Management ---
    Mod+C { close-window; }
    Mod+M { quit; } // Logs you out of Niri

    // --- Basic Navigation ---
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-workspace-up; }
    Mod+J     { focus-workspace-down; }

    // --- Overview ---
    Mod+Z     { toggle-overview; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // --- Basic Workspaces ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id="kitty"
    match is-active=true
    opacity 1.0 
}
